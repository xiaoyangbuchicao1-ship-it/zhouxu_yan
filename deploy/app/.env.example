# Copy to deploy/app/.env on the machine that runs Docker Compose.
# Do not commit the copied .env.
OPENSEARCH_VERSION=2.19.0
OPENSEARCH_CLUSTER_NAME=maritime-law-dev
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_AtLeast8Chars
DEEPSEEK_API_KEY=replace_with_your_key

# First deployment administrator. The API hashes the password on first
# startup and never writes the plaintext to the project or logs.
ZHOUXU_ADMIN_EMAIL=
ZHOUXU_ADMIN_PASSWORD=

# Optional OpenAI-compatible relay. Fill these two values directly in .env.
# Keep the key private; do not commit deploy/app/.env.
ZHOUXU_RELAY_ENDPOINT=
ZHOUXU_RELAY_API_KEY=
# Example format only: https://your-relay-host.example and sk-...

# Use local image tags when building on this machine. For a registry, replace
# these with fully qualified image names and run docker compose pull.
ZHOUXU_API_IMAGE=zhouxu-api:local
ZHOUXU_WEB_IMAGE=zhouxu-web:local
ZHOUXU_WEB_PORT=8080
ZHOUXU_RUNTIME_ENV_FILE=.env
# Directory containing the pinned Hugging Face cache for BAAI/bge-m3.
# Use an absolute D: path on Windows, or an absolute Linux path on servers.
ZHOUXU_HF_CACHE_DIR=../../models/huggingface
ZHOUXU_PAPER_FONT_DIR=../../models/fonts
# Legacy import source only. Active SQLite stores live in the Linux named
# volume <compose-project>_runtime-state; export it before moving computers.
ZHOUXU_RUN_STATE_DIR=../../data/runtime
# External, read-only research resources. They remain outside the ZhouXu
# repository and are mounted into the init/API containers at runtime.
ZHOUXU_INFORMATION_CARDS_DIR=../../../信息卡
ZHOUXU_CAPABILITY_CARDS_DIR=../../../能力卡
ZHOUXU_CSL_PAPER_SKILL_DIR=../../../技能候选/csl-law-paper-generator
# Original papers used by the authenticated reader. Both mounts are read-only.
ZHOUXU_PDF_DIR=../../../PDF
ZHOUXU_MD_DIR=../../../md
